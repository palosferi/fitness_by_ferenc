# Garmin Connect login (used only by the unofficial garminconnect library, stored/read locally)
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Used to estimate max HR (220 - age) for the strain calculation.
# If you know your real tested max HR, set USER_MAX_HR instead and skip USER_AGE.
USER_AGE=32
# USER_MAX_HR=188

# Your typical easy pace, used to turn a recommended run duration into a distance.
USER_EASY_PACE_MIN_PER_KM=6.0

# Web dashboard port (reachable over Tailscale)
DASHBOARD_PORT=8420

# Absolute paths - fill in once you know the install directory on the server
FITNESS_DB_PATH=/home/YOURUSER/fitness_by_ferenc/fitness.db
GARMIN_TOKENSTORE=/home/YOURUSER/fitness_by_ferenc/.garminconnect_tokens

# --- Optional tuning (sensible defaults if left unset) ---

# Banister TRIMP exponent for strain - 1.92 is the standard "male" value,
# 1.67 is typically used for women.
# USER_TRIMP_EXPONENT=1.92

# Ring/stat coloring thresholds (red below LOW, amber below HIGH, green above).
# RING_LOW_THRESHOLD=40
# RING_HIGH_THRESHOLD=70

# Surface the training-load-risk badge when ACWR percent drops below this.
# ACWR_RISK_THRESHOLD_PERCENT=60

# Dashboard/widget show a "stale" notice if the last sync is older than this
# many minutes (default is 2.5x the 30-minute sync timer interval).
# SYNC_STALE_MINUTES=75

# Where daily DB backups go, and how long to keep them.
# BACKUP_DIR=/home/YOURUSER/fitness_by_ferenc/backups
# BACKUP_RETENTION_DAYS=30
