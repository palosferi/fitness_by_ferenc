[Unit]
Description=Backup Garmin fitness SQLite database (one-shot)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/YOURUSER/fitness_by_ferenc
EnvironmentFile=/home/YOURUSER/fitness_by_ferenc/.env
ExecStart=/home/YOURUSER/fitness_by_ferenc/venv/bin/python /home/YOURUSER/fitness_by_ferenc/backup.py
User=YOURUSER
